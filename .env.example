# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Matches docker-compose.yml
DATABASE_URL=postgres://paybridge:paybridge@localhost:5432/paybridge
REDIS_URL=redis://localhost:6379

# Signs access tokens. At least 32 characters; generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Only set to true behind a proxy that sets X-Forwarded-For (e.g. Render).
TRUST_PROXY=false
