# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Matches docker-compose.yml
DATABASE_URL=postgres://paybridge:paybridge@localhost:5432/paybridge
REDIS_URL=redis://localhost:6379

# Signs access tokens. At least 32 characters; generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Only set to true behind a proxy that sets X-Forwarded-For (e.g. Render).
TRUST_PROXY=false

# Safaricom Daraja (M-Pesa). Create a sandbox app at https://developer.safaricom.co.ke
# and copy its Consumer Key/Secret. The sandbox passkey for shortcode 174379 is
# under APIs -> M-Pesa Express -> Simulate on the portal.
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-passkey
# sandbox or production
MPESA_ENV=sandbox

# Public HTTPS origin Daraja sends STK callbacks to. Locally, use a tunnel
# such as `ngrok http 3000` or `cloudflared tunnel --url http://localhost:3000`.
PUBLIC_BASE_URL=https://your-tunnel.example.com

# Optional: comma-separated IPs allowed to post STK callbacks (empty = any).
# Use the callback IPs Safaricom publishes for your environment.
MPESA_CALLBACK_IP_ALLOWLIST=

# Encrypts merchants' webhook signing secrets at rest. At least 32 characters;
# generate one with: openssl rand -base64 48
WEBHOOK_ENCRYPTION_KEY=change-me-to-another-long-random-string-32-plus

# Let webhook URLs point at localhost/private IPs. Local development only:
# in production this would let a merchant make PayBridge call internal services.
WEBHOOK_ALLOW_PRIVATE_URLS=true

# Run the BullMQ workers (webhook delivery, reconciliation) in the API process.
RUN_WORKERS=true
